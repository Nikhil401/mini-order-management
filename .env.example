# Local Docker Compose configuration. Copy to .env and replace values.
IMAGE_PREFIX=mini-orders
IMAGE_TAG=local
SQL_PASSWORD=replace-with-a-strong-local-password
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=replace-with-a-local-password
JWT_ISSUER=MiniOrderManagement
JWT_AUDIENCE=MiniOrderManagement
JWT_KEY=replace-with-a-long-local-signing-key
